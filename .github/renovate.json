{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "customManagers:githubActionsVersions",
    "helpers:pinGitHubActionDigests"
  ],
  "baseBranchPatterns": [
    "develop"
  ],
  "enabledManagers": [
    "cargo",
    "github-actions",
    "custom.regex",
    "rust-toolchain"
  ],
  "timezone": "Etc/UTC",
  "labels": [
    "dependencies"
  ],
  "semanticCommits": "enabled",
  "semanticCommitType": "build",
  "semanticCommitScope": "deps",
  "prConcurrentLimit": 1,
  "packageRules": [
    {
      "description": "Label GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "addLabels": [
        "github-actions"
      ]
    },
    {
      "description": "Group CodeQL actions",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "github/codeql-action",
        "github/codeql-action/**"
      ],
      "groupName": "codeql-action"
    },
    {
      "description": "Label Cargo updates",
      "matchManagers": [
        "cargo"
      ],
      "addLabels": [
        "rust"
      ]
    },
    {
      "description": "Group all patch updates of Rust crates",
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "groupName": "patch-updates"
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "capnp",
        "capnpc"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "groupName": "capnp",
      "description": "Keep the runtime and code generator compatible"
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "chrono",
        "chrono-*"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "groupName": "chrono"
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "clap",
        "clap_*"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "groupName": "clap"
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "crossbeam",
        "crossbeam-*"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "groupName": "crossbeam"
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "enumset",
        "enumset-*",
        "enumset_*"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "groupName": "enumset"
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "pest",
        "pest_*"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "groupName": "pest"
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "unicode-*"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "groupName": "unicode"
    },
    {
      "description": "Tools pinned in workflows via `# renovate:` comments",
      "matchManagers": [
        "custom.regex"
      ],
      "addLabels": [
        "github-actions"
      ]
    },
    {
      "description": "Automerge all updates once required checks pass, after a release has had a week to be caught if compromised",
      "matchPackageNames": [
        "*"
      ],
      "automerge": true,
      "automergeStrategy": "squash",
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "The first-party rust-clap revision has no release timestamp",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "https://github.com/pamburus/rust-clap.git"
      ],
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "Use `build` commit type for all updates, overriding the per-type defaults from `config:recommended`",
      "matchPackageNames": [
        "*"
      ],
      "semanticCommitType": "build"
    }
  ],
  "schedule": [
    "* */6 * * *"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "GitHub runner labels in matrix entries and expressions, which the github-actions manager does not handle",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "\\bos: (?<depName>ubuntu|macos|windows)-(?<currentValue>[0-9.]+)\\b",
        "'(?<depName>ubuntu|macos|windows)-(?<currentValue>[0-9.]+)'"
      ],
      "datasourceTemplate": "github-runners"
    }
  ]
}
